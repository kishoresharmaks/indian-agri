# ============================================================
# INDIAN AGRICULTURE B2B — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# MongoDB Atlas Connection String
# Get this from https://cloud.mongodb.com → your cluster → Connect
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mplx.mongodb.net/indianagri?retryWrites=true&w=majority

# ============================================================
# ADMIN AUTHENTICATION (REQUIRED)
# ============================================================
# These MUST be set — there are NO fallback defaults.
# Rotate these immediately if they have been exposed.

ADMIN_USERNAME=ntvigneswaran@gmail.com
ADMIN_PASSWORD=957878443V@

# ============================================================
# PAYMENT SETTINGS
# ============================================================
# Your official merchant UPI ID (for UPI payments)
NEXT_PUBLIC_MERCHANT_UPI_ID=

# ============================================================
# SAAS LICENSING & SUBSCRIPTION CONFIG
# ============================================================
# URL of the standalone licensing server (deploy licensing-server/ first)
LICENSING_SERVER_URL=https://license.yourdomain.com
NEXT_PUBLIC_LICENSING_SERVER_URL=https://license.yourdomain.com

# License key for this installation — must exist in the licensing server's DB
LICENSE_KEY=

# Must match LICENSE_MASTER_SECRET on the licensing server
LICENSE_MASTER_SECRET=

# ============================================================
# RAZORPAY GATEWAY (for automated subscription renewals)
# ============================================================
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — from Razorpay Dashboard → Settings → Webhooks (after adding webhook URL)
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# MANUAL PAYMENT DETAILS (shown to clients for direct transfers)
# ============================================================
MANUAL_UPI_ID=
MANUAL_UPI_NAME=INDIAN AGRICULTURE
MANUAL_UPI_QR_URL=
BANK_ACCOUNT_NAME=INDIAN AGRICULTURE
BANK_ACCOUNT_NUMBER=
BANK_IFSC_CODE=
BANK_NAME=

# ============================================================
# SUPPORT CONTACT (shown in licensing modals — required, no hardcoded fallback)
# These MUST be set or the support section will be hidden in the UI.
LICENSE_SUPPORT_PHONE=
LICENSE_SUPPORT_EMAIL=

# ============================================================
# COMPANY & INVOICE BILLING METADATA
# These are used in invoice generation and PDF exports
# ============================================================
NEXT_PUBLIC_COMPANY_NAME="INDIAN AGRICULTURE"
NEXT_PUBLIC_COMPANY_OWNER="JEYA SHAYANA DEVI.T"
